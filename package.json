{
  "name": "jewelry-commerce-be",
  "version": "0.1.0",
  "private": true,
  "description": "Graduation-project NestJS modular monolith",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.cjs",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "db:migrate": "ts-node src/database/migrate.ts",
    "test:integration": "npm run build && node --test dist/test/catalog.integration.js",
    "admin:provision": "ts-node src/auth/infrastructure/provision-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "helmet": "8.1.0",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/multer": "2.1.0",
    "@types/node": "24.10.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
